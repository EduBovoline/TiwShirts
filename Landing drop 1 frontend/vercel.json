{
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog", "destination": "/manual", "permanent": true },
    { "source": "/blog.html", "destination": "/manual", "permanent": true }
  ],
  "rewrites": [
    { "source": "/manual", "destination": "/manual.html" },
    { "source": "/manualdousuario-cannabis", "destination": "/manual.html" },
    { "source": "/manualdousuario-cannabis.html", "destination": "/manual.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
