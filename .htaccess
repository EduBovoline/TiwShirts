# TiwShirts — Roteamento do Manual do Usuário
# Resolve os três acessos para manual.html (fonte canônica)

Options -Indexes
RewriteEngine On

# /manual (sem barra) → manual.html
RewriteRule ^manual$ /manual.html [R=301,L]

# /manual/ (com barra) → manual.html
RewriteRule ^manual/$ /manual.html [R=301,L]

# /manualdousuario-cannabis (sem .html) → manual.html
RewriteRule ^manualdousuario-cannabis$ /manual.html [R=301,L]

# /manualdousuario-cannabis.html → manual.html (redirect 301 permanente)
RewriteRule ^manualdousuario-cannabis\.html$ /manual.html [R=301,L]

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Cache de assets estáticos (melhora performance dos vídeos)
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm|jpg|webp|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Habilita byte-range requests — necessário para scrub de vídeo via HTTP (sem blob)
<IfModule mod_headers.c>
  Header set Accept-Ranges "bytes"
</IfModule>
